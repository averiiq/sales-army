# ==============================================================================
# SalesArmy - Supabase & Backend Environment Configuration
# ==============================================================================
#
# This file is a TEMPLATE. Fill real values into `.env` (gitignored) locally and
# inject the equivalent values via GitHub Actions secrets / Secret Manager in
# every deployed environment. NEVER commit real credentials.
#
# If you rotate your Supabase project keys (recommended whenever a key may have
# been exposed in a prior commit), you MUST also purge the old values from git
# history — e.g. via `git filter-repo` or BFG — because gitignoring .env does
# not retroactively hide a leaked value.

# ------------------------------------------------------------------------------
# Supabase credentials
# ------------------------------------------------------------------------------
SUPABASE_URL=https://REPLACE_ME.supabase.co

# Public anonymous key — ships to clients. Still rotate on exposure.
SUPABASE_ANON_KEY=REPLACE_ME_SUPABASE_ANON_KEY

# Service role key — bypasses RLS. Server-side only. NEVER ship to a client,
# NEVER commit, load from a secret manager at runtime.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SUPABASE_SERVICE_ROLE_KEY

# ------------------------------------------------------------------------------
# Direct Postgres connection string (used by `supabase` CLI / migrations only)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.REPLACE_ME:REPLACE_ME_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# Web admin server
# ------------------------------------------------------------------------------
PORT=3000

# Explicit demo-auth gate. Leave UNSET in all non-development environments.
# Set to `true` only on a developer workstation, and only when you understand
# that this enables seeded accounts with well-known passwords.
# ENABLE_DEMO_AUTH=true

# ------------------------------------------------------------------------------
# Client-side (publishable) config
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_ME_PUBLISHABLE_KEY
