PORT=3000
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set the exact HTTPS admin origin when behind a TLS reverse proxy.
ALLOWED_ORIGINS=https://admin.example.com
# Enable only behind a reverse proxy that overwrites forwarded headers.
TRUST_PROXY=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay dashboard → Webhooks → https://<admin-host>/api/checkout/webhook, event payment_link.paid
