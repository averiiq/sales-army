{
  "name": "salesarmy-web-admin",
  "version": "2.0.0",
  "private": true,
  "description": "SalesArmy Super Admin portal and platform API (Cloudflare Worker + Node adapter over Supabase)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "live": "node scripts/start-live.js",
    "tunnel": "npx --yes cloudflared tunnel --url http://127.0.0.1:3000",
    "deploy": "npx wrangler deploy",
    "test": "node --test \"test/*.test.mjs\"",
    "sync:edge": "node scripts/sync-edge.mjs"
  },
  "license": "UNLICENSED"
}
